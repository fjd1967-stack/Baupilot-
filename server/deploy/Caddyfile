{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
	@gesperrt path /server/* /.git/* /*.md /LIESMICH.txt
	respond @gesperrt 404
	@api path /api/* /webhook/*
	reverse_proxy @api app:3000
	root * /srv/site
	file_server
}
