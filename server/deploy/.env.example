DOMAIN=ordobau.de
BASE_URL=https://ordobau.de
# Zufälliger langer Wert: openssl rand -base64 48
APP_SECRET=
APP_NAME=BauPilot
AGB_VERSION=2026-11-entwurf
# Stripe (Dashboard > Entwickler > API-Schlüssel / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# stripe_tax = Umsatzsteuer automatisch (Stripe Tax im Dashboard aktivieren), fest = ein Satz über STRIPE_TAX_RATE_ID
TAX_MODE=stripe_tax
STRIPE_TAX_RATE_ID=
# Mailversand (SMTPS, Port 465). Absender muss zur Domain passen (SPF/DKIM/DMARC einrichten).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BauPilot <noreply@ordobau.de>"

# KI-Assistent (Zusatz pro Nutzer, netto in Cent) und Zugang zur KI
PRICE_KI_CENT=1490
ANTHROPIC_API_KEY=
KI_MODELL=claude-sonnet-4-5
